# Database
DATABASE_URL=postgresql://user:password@localhost:5432/art_marketplace

# Redis (para Celery)
REDIS_URL=redis://localhost:6379/0

# Arbitrum RPC (Alchemy u otro)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key

# Smart Contract (se obtiene tras despliegue)
ESCROW_CONTRACT_ADDRESS=0x...

# Wallet de la ONG (solo para monitoreo, sin fondos)
ONG_PUBLIC_KEY=0x...
ONG_PRIVATE_KEY=0x...   # NUNCA en producción real; aquí solo para desarrollo local

# USDC token en Arbitrum
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173